<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Fees Management System</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-50 min-h-screen p-6">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <header class="mb-8">
            <h1 class="text-3xl font-extrabold text-slate-800">🎓 Student Fees Management System</h1>
            <p class="text-slate-500">Track student records, dues, and payment collections seamlessly.</p>
        </header>

        <!-- Analytics Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                <p class="text-sm font-medium text-slate-500">Total Students</p>
                <h3 id="statTotalStudents" class="text-2xl font-bold text-slate-800">0</h3>
            </div>
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                <p class="text-sm font-medium text-slate-500">Total Revenue Collected</p>
                <h3 id="statCollected" class="text-2xl font-bold text-emerald-600">$0.00</h3>
            </div>
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
                <p class="text-sm font-medium text-slate-500">Total Pending Dues</p>
                <h3 id="statPending" class="text-2xl font-bold text-rose-600">$0.00</h3>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Add Student Form -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 h-fit">
                <h2 class="text-xl font-bold text-slate-800 mb-4">Add New Student</h2>
                <form id="studentForm" onsubmit="addStudent(event)" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Full Name</label>
                        <input type="text" id="name" required class="mt-1 w-full p-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Roll Number / ID</label>
                        <input type="text" id="roll_no" required class="mt-1 w-full p-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Class / Grade</label>
                        <input type="text" id="class_name" required class="mt-1 w-full p-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Total Fee Amount ($)</label>
                        <input type="number" step="0.01" id="total_fees" required class="mt-1 w-full p-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700">Initial Paid Amount ($)</label>
                        <input type="number" step="0.01" id="paid_fees" required class="mt-1 w-full p-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium p-2 rounded-lg transition">Register Student</button>
                </form>
            </div>

            <!-- Student Records Table -->
            <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-slate-100 overflow-x-auto">
                <h2 class="text-xl font-bold text-slate-800 mb-4">Fee Records Directory</h2>
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 text-slate-500 text-sm">
                            <th class="p-3">Student Info</th>
                            <th class="p-3">Class</th>
                            <th class="p-3">Total / Paid</th>
                            <th class="p-3">Status</th>
                            <th class="p-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody" class="divide-y divide-slate-100 text-sm">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Change this URL once you deploy your backend (e.g., "https://your-backend.onrender.com")
        const API_URL = "http://127.0.0.1:8000";

        async function fetchStudents() {
            try {
                const res = await fetch(`${API_URL}/students`);
                const students = await res.json();
                renderTable(students);
                updateAnalytics(students);
            } catch (err) {
                console.error("Failed to fetch students:", err);
            }
        }

        function renderTable(students) {
            const tbody = document.getElementById("studentTableBody");
            if (students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">No student records found.</td></tr>`;
                return;
            }

            tbody.innerHTML = students.map(s => {
                const due = s.total_fees - s.paid_fees;
                const statusColor = due === 0 ? "bg-emerald-100 text-emerald-700" : (s.paid_fees > 0 ? "bg-amber-100 text-amber-700" : "bg-rose-100 text-rose-700");
                const statusText = due === 0 ? "Paid Full" : (s.paid_fees > 0 ? "Partial" : "Unpaid");

                return `
                    <tr class="hover:bg-slate-50">
                        <td class="p-3">
                            <div class="font-bold text-slate-800">${s.name}</div>
                            <div class="text-xs text-slate-400">ID: ${s.roll_no}</div>
                        </td>
                        <td class="p-3 text-slate-600">${s.class_name}</td>
                        <td class="p-3">
                            <div class="text-slate-800 font-medium">$${s.paid_fees} / $${s.total_fees}</div>
                            <div class="text-xs text-rose-500">Due: $${due.toFixed(2)}</div>
                        </td>
                        <td class="p-3">
                            <span class="px-2 py-1 rounded-full text-xs font-semibold ${statusColor}">${statusText}</span>
                        </td>
                        <td class="p-3 text-right space-x-2">
                            ${due > 0 ? `<button onclick="addPayment(${s.id}, ${s.total_fees - s.paid_fees})" class="text-indigo-600 hover:underline font-medium">Pay</button>` : ''}
                            <button onclick="deleteStudent(${s.id})" class="text-rose-600 hover:underline font-medium">Delete</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function updateAnalytics(students) {
            const totalStudents = students.length;
            const totalCollected = students.reduce((sum, s) => sum + s.paid_fees, 0);
            const totalPending = students.reduce((sum, s) => sum + (s.total_fees - s.paid_fees), 0);

            document.getElementById("statTotalStudents").innerText = totalStudents;
            document.getElementById("statCollected").innerText = `$${totalCollected.toFixed(2)}`;
            document.getElementById("statPending").innerText = `$${totalPending.toFixed(2)}`;
        }

        async function addStudent(e) {
            e.preventDefault();
            const data = {
                name: document.getElementById("name").value,
                roll_no: document.getElementById("roll_no").value,
                class_name: document.getElementById("class_name").value,
                total_fees: parseFloat(document.getElementById("total_fees").value),
                paid_fees: parseFloat(document.getElementById("paid_fees").value)
            };

            const res = await fetch(`${API_URL}/students`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                document.getElementById("studentForm").reset();
                fetchStudents();
            } else {
                const err = await res.json();
                alert(err.detail || "Error adding student");
            }
        }

        async function addPayment(id, maxDue) {
            const amountStr = prompt(`Enter payment amount (Max Due: $${maxDue}):`);
            if (!amountStr) return;
            const amount = parseFloat(amountStr);

            if (isNaN(amount) || amount <= 0) {
                alert("Please enter a valid amount");
                return;
            }

            const res = await fetch(`${API_URL}/students/${id}/pay`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ paid_fees: amount })
            });

            if (res.ok) {
                fetchStudents();
            } else {
                const err = await res.json();
                alert(err.detail || "Payment update failed");
            }
        }

        async function deleteStudent(id) {
            if (!confirm("Are you sure you want to delete this record?")) return;
            const res = await fetch(`${API_URL}/students/${id}`, { method: "DELETE" });
            if (res.ok) fetchStudents();
        }

        // Initialize App
        fetchStudents();
    </script>
</body>
</html>
